# Application Configuration
APP_NAME="AI Employee"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO

# Database Configuration (SQLite for local MVP)
DATABASE_URL=sqlite:///./ai_employee.db

# Security & JWT Configuration
SECRET_KEY=change-me-to-a-strong-random-64-char-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM & Voice Provider Configuration ("ollama", "groq", or "gemini")
LLM_PROVIDER=groq
OLLAMA_MODEL=gemma
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Langfuse Observability Configuration
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS Configuration (comma-separated origins, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
